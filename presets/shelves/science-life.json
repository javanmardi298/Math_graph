d","transport":{"duration":30,"bpm":90},"view":{"xMin":-2.3,"xMax":2.3,"yMin":-4.0889,"yMax":4.0889},"params":{"a":0.2},"sequence":{"enabled":false,"past":"keep"},"layers":[{"name":"Van der Pol","type":"ode","exprs":{"x":"y","y":"a*(1-x^2)*y-x","z":"0"},"width":2.6,"colorMode":"gradient","color":"#ff4f6a","color2":"#ffd1dc","wave":"marimba","volume":0.9,"samples":5000,"sim":{"x0":0.5,"y0":0,"z0":0,"dt":0.01,"skip":0}}],"visual":{"aspect":"9:16","drawMode":"trace","background":"#0c0305","gridColor":"#210d10","axesColor":"#5d2830","showGrid":false,"showAxes":false,"backdrop":"rings","backdropColor":"#ff4f6a","backdropMotion":"still","tone":"soft","exposure":1,"loop":"fade","loopSecs":2.6,"letterbox":0,"fx":{"style":"pulse","tail":0.5,"offset":3,"strings":90,"stringAlpha":0.16,"hold":0,"intensity":1,"copies":6},"bloom":{"enabled":true,"strength":0.45,"radius":0.45,"threshold":0.12},"trail":{"enabled":true,"count":120,"size":4},"marker":{"shape":"circle","size":22,"smoothing":0.3,"cursorLine":false}},"camera":{"ending":"off","endingSecs":4.2,"endingBars":0,"track":0,"trackSpeed":0.1,"zoom":1,"roll":0,"fov":45,"autoRotate":false,"rotateSpeed":2},"audio":{"master":0.9,"scale":"minorPentatonic","root":9,"noteLow":47.4666,"noteHigh":96.5334,"glide":30,"articulation":"pluck","reverb":{"decay":3.4,"mix":0.38,"tone":0.7,"preDelay":0.02},"delay":{"time":0.375,"feedback":0.26,"mix":0.13,"pingpong":true}},"rhythm":{"enabled":false,"showGrid":false},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.12,"size":0.5,"start":12,"end":28},"texts":[]},"keyframes":{"tracks":{"params.a":[{"time":0,"value":0.2,"ease":"smooth"},{"time":15,"value":2.4,"ease":"smooth"},{"time":30,"value":0.2,"ease":"smooth"}]},"autoKey":false},"hook":{"text":"The shape of a heartbeat"},"youtube":{"title":"The van der Pol oscillator: from a circle to a heartbeat ❤️ #shorts","description":"x'' − μ(1 − x²)x' + x = 0: negative friction when small, positive when large; μ grows from 0.2 to 2.4 and back. Drawn: position across, speed up.\n\nWhich one should I make next? 👇\n\n#math #science #shorts","tags":"math, science, chaos, math art, math animation, physics, satisfying, shorts"},"about":{"title":"Heartbeat Oscillator (van der Pol)","sources":[{"label":"Van der Pol oscillator","url":"https://en.wikipedia.org/wiki/Van_der_Pol_oscillator"}],"math":"x'' − μ(1 − x²)x' + x = 0: negative friction when small, positive when large; μ grows from 0.2 to 2.4 and back. Drawn: position across, speed up.","aha":"Every start ends on the same loop (a limit cycle). Small μ gives a smooth circle; large μ gives slow build-ups and sudden jumps, a relaxation oscillation, like a heartbeat.","why":"Balthasar van der Pol, 1927, studying radio valves; later used as a model of the heart’s pacemaker."}}]}
