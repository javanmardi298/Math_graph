ok":{"trail":"lines","palette":"fire","bloom":0.5},"sound":{"instrument":"e-piano","pitch":"angle","volume":0.6,"maxRate":22,"length":1.2},"text":{"formula":"…messy ratios sound tense"}}}]},"hook":{"text":"Why do some notes sound good together?"},"youtube":{"title":"Why some notes sound good together 🎹 #shorts","description":"Two notes sound sweet when their frequencies make a simple ratio: 2:1 (octave), 3:2 (fifth), 4:3 (fourth). An oscilloscope shows it: simple ratios draw calm closed shapes, messy ones scribble.\n\n#satisfying #simulation #shorts","tags":"music theory, intervals, lissajous, harmony, math, shorts"}},{"name":"Lesson · Moving Sound","mode":"circle","transport":{"duration":26,"bpm":100},"visual":{"aspect":"9:16"},"overlay":{"layout":4,"name":{"enabled":false}},"audio":{"scale":"minorPentatonic","root":9,"noteLow":50,"noteHigh":86,"reverb":{"decay":3.5,"mix":0.35},"delay":{"time":0.375,"feedback":0.3,"mix":0.16}},"circle":{"rule":"doppler","lab":{"doppler":{"machs":"0 0.6","every":5}},"look":{"trail":"lines","palette":"fire","ambience":true},"sound":{"instrument":"synth-pluck","pitch":"angle","volume":0.6,"maxRate":22},"text":{"formula":"Still, then moving: squeezed waves…"},"combine":"sequence","layers":[{"id":"C2","enabled":true,"withPrev":false,"cfg":{"rule":"doppler","lab":{"doppler":{"machs":"1 1.6","every":6}},"look":{"trail":"lines","palette":"fire"},"sound":{"instrument":"synth-pluck","pitch":"angle","volume":0.6,"maxRate":22},"text":{"formula":"…faster than sound: a cone"}}}]},"hook":{"text":"Why does a siren change its pitch?"},"youtube":{"title":"The Doppler effect and the sonic boom 🚑 #shorts","description":"A moving source squeezes the waves ahead (higher pitch) and stretches them behind (lower pitch). Faster than its own sound, the waves pile up into a cone: the sonic boom.\n\n#satisfying #simulation #shorts","tags":"doppler effect, sonic boom, sound, physics, education, shorts"}},{"name":"Lesson · Invisible Fields","mode":"circle","transport":{"duration":33,"bpm":100},"visual":{"aspect":"9:16"},"overlay":{"layout":4,"name":{"enabled":false}},"audio":{"scale":"minorPentatonic","root":9,"noteLow":50,"noteHigh":86,"reverb":{"decay":3.5,"mix":0.35},"delay":{"time":0.375,"feedback":0.3,"mix":0.16}},"circle":{"rule":"filings","lab":{"filings":{"setups":"bar","every":30}},"look":{"trail":"lines","palette":"neon","ambience":true},"sound":{"instrument":"synth-pluck","pitch":"angle","volume":0.55,"maxRate":22},"text":{"formula":"A magnet…"},"combine":"sequence","layers":[{"id":"C2","enabled":true,"withPrev":false,"cfg":{"rule":"filings","lab":{"filings":{"setups":"wire","every":30,"wait":0.3}},"look":{"trail":"lines","palette":"gold"},"sound":{"instrument":"marimba","pitch":"angle","volume":0.8,"maxRate":22},"text":{"formula":"…a wire with a current…"}}},{"id":"C3","enabled":true,"withPrev":false,"cfg":{"rule":"filings","lab":{"filings":{"setups":"coil","every":30,"wait":0.3}},"look":{"trail":"lines","palette":"gold"},"sound":{"instrument":"marimba","pitch":"angle","volume":0.8,"maxRate":22},"text":{"formula":"…a coil: a magnet again"}}}]},"hook":{"text":"Can electricity make a magnet?"},"youtube":{"title":"From a magnet to a wire to a coil 🧲⚡ #shorts","description":"Iron filings show the field of a bar magnet, of a single wire carrying a current (circles), and of a coil, which looks just like the bar magnet. That is how electromagnets and motors work.\n\n#satisfying #simulation #shorts","tags":"electromagnetism, magnetic field, iron filings, physics, education, shorts"}},{"name":"Lesson · Numbers on a Circle","mode":"circle","transport":{"duration":33,"bpm":100},"visual":{"aspect":"9:16"},"overlay":{"layout":4,"name":{"enabled":false}},"audio":{"scale":"minorPentatonic","root":9,"noteLow":50,"noteHigh":86,"reverb":{"decay":3.5,"mix":0.35},"delay":{"time":0.375,"feedback":0.3,"mix":0.16}},"circle":{"rule":"times","lab":{"times":{"build":2,"morph":4,"to":4}},"look":{"trail":"lines","palette":"rainbow","ambience":true},"sound":{"instrument":"e-piano","pitch":"angle","volume":0.7,"maxRate":22},"text":{"formula":"Times tables on a circle…"},"combine":"sequence","layers":[{"id":"C2","enabled":true,"withPrev":false,"cfg":{"rule":"chord","lab":{"chord":{}},"look":{"trail":"lines","palette":"gold","trailWidth":1.4},"sound":{"instrument":"marimba","pitch":"angle","volume":0.7,"maxRate":22},"text":{"formula":"…a fraction closes into a star…"},"chord":{"step":"2/7","speed":3.2}}},{"id":"C3","enabled":true,"withPrev":false,"cfg":{"rule":"phyllo","lab":{"phyllo":{"rate0":12,"accel":1.35}},"look":{"trail":"lines","palette":"gold"},"sound":{"instrument":"kalimba","pitch":"angle","volume":0.7,"maxRate":22},"text":{"formula":"…the golden angle never repeats"}}}]},"hook":{"text":"What do numbers look like on a circle?"},"youtube":{"title":"Three secrets of numbers on a circle 🌻 #shorts","description":"Multiply around a circle and a heart shape appears. Jump by a fraction and you close into a star. Jump by the golden angle and you never land twice: that is how sunflowers pack their seeds.\n\n#satisfying #simulation #shorts","tags":"times tables, golden angle, phyllotaxis, math, education, shorts"}}]}
