07179586},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"polar","exprs":{"r":"0.2 theta"},"range":{"min":0,"max":12.566370614359172},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"r = 2: the same distance everywhere, a circle","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"r = 1.4(1 + cos θ): a heart (cardioid)","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"r = 0.2θ: further each turn, a spiral","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"What if distance depends on the angle?"},"youtube":{"title":"Polar curves: circles, hearts and spirals 🌀 #shorts","description":"In polar form you give the distance r for every angle θ. A constant draws a circle, 1 + cos θ draws a heart, and r growing with θ draws a spiral.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Rose Curves","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":-3,"xMax":3,"yMin":-5.3,"yMax":5.3},"sequence":{"enabled":true,"past":"keep"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"polar","exprs":{"r":"2.6 cos(2theta)"},"range":{"min":0,"max":6.283185307179586},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1