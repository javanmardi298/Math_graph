shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Frequency","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":0,"xMax":6.3,"yMin":-5,"yMax":5},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"2.5 sin(x)"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"2.5 sin(2x)"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"2.5 sin(4x)"},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"sin x: one wave in 2π","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"sin 2x: twice as many waves","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"sin 4x: more waves, faster wobble","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"What does the number inside do?"},"youtube":{"title":"Frequency: how many waves fit 〰️ #shorts","description":"Multiply x inside the sine and the waves squeeze together. More waves per second is a higher frequency: a higher pitch.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Phase Shift","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":0,"xMax":6.3,"yMin":-5,"yMax":5},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"2.5 sin(x)"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"2.5 sin(x - 1)"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"2.5 cos(x)"},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"sin x starts at zero","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"sin(x − 1): the same wave, moved right","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"cos x is sin x shifted by π/2","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"Is cosine just a moved sine?"},"youtube":{"title":"Phase shift: sine and cosine are the same wave 🔁 #shorts","description":"Subtract a number inside the sine and the whole wave slides to the right. Slide it by a quarter turn (π/2) and you get the cosine.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Adding Waves","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":0,"xMax":6.