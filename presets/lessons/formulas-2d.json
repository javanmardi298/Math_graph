angle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"x"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"2x"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"-x/2 + 2"},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"y = x: up one for every step right","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"y = 2x: steeper, twice as fast","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"y = −x/2 + 2: going down","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"What does the slope sound like?"},"youtube":{"title":"Slope: how fast a line climbs 📐 #shorts","description":"In y = m·x + b, m is the slope: how much the line climbs for every step to the right. A steeper line rises in pitch faster; a negative slope falls.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Parabolas","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":-3.5,"xMax":3.5,"yMin":-5,"yMax":7},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"x^2 - 3"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"(x - 1.5)^2 - 3"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"-x^2 + 4"},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"y = x²: a U shape","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"Move it: (x − 1.5)² − 3","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"Flip it: −x² + 4","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"How do you move a parabola?"},"youtube":{"title":"Parabolas: move and flip a U 🎢 #shorts","description":"y = x² makes a U. Subtract inside the bracket and it moves sideways; add outside and it moves up; a minus sign flips it upside down. Thrown balls fly in parabolas.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Growth and Decay","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":0,"xMax":6,"yMin":-5,"yMax":5},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"0.1*2^x - 3"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"6 exp(-x) - 3"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"4 exp(-0.5x) sin(6x)"},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"Doubling: 2^x grows faster and faster","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"Halving: e^(−x) dies away","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"A fading note: e^(−x/2)·sin 6x","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"Why do plucked notes fade?"},"youtube":{"title":"Exponential growth and decay 📉 #shorts","description":"2^x doubles with every step: exponential growth. e^(−x) keeps halving: decay. Multiply a wave by decay and you get the shape of a plucked string fading away.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · Absolute Value","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":-3,"xMax":3,"yMin":-4,"yMax":5},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"|x| - 2"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"3 |sin(x)| - 2"},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"function","exprs":{"y":"6 |cos(1.5x)| exp(-0.35(x + 3)) - 3"},"style":"dots","withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"|x|: negatives turn positive, a V","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"|sin x|: every dip flips up","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"Shrinking bounces: a bouncing ball","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"What do the bars | | do?"},"youtube":{"title":"Absolute value: flip the negatives ⤴️ #shorts","description":"Absolute value turns every negative number positive. A line becomes a V, a sine wave becomes a row of bumps, and with decay it becomes a bouncing ball.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}},{"name":"Lesson · The Sound of a Formula","mode":"2d","transport":{"duration":27,"bpm":100},"view":{"xMin":-4,"xMax":4,"yMin":-6,"yMax":6},"sequence":{"enabled":true,"past":"ghost"},"layers":[{"name":"Step 1","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#22e4ff","type":"function","exprs":{"y":"x"},"withPrev":false},{"name":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"function","exprs":{"y":"-x"},"withPrev":false},{