":"Step 2","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#8cff5a","type":"parametric","exprs":{"x":"2.4 cos(s)","y":"4.2 sin(s)","z":"0"},"range":{"min":0,"max":6.283185307179586},"withPrev":false},{"name":"Step 3","wave":"triangle","volume":1,"width":5,"samples":1400,"color":"#ffd23d","type":"parametric","exprs":{"x":"2.4 sin(3s)","y":"4.2 sin(2s)","z":"0"},"range":{"min":0,"max":6.283185307179586},"withPrev":false}],"visual":{"aspect":"9:16","drawMode":"trace","marker":{"shape":"circle","size":30}},"camera":{},"audio":{"master":0.95,"scale":"pentatonic","root":2,"noteLow":48,"noteHigh":84,"articulation":"pluck","reverb":{"mix":0.3,"decay":3}},"overlay":{"layout":4,"name":{"enabled":false},"formulas":{"enabled":true,"x":0.06,"y":0.15,"size":1.5},"texts":[{"id":"step1","text":"x = cos s, y = sin s: a circle","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":0,"end":9},{"id":"step2","text":"Stretch y: an ellipse","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":9,"end":18},{"id":"step3","text":"x = sin 3s, y = sin 2s: a Lissajous knot","x":0.5,"y":0.7,"size":0.62,"color":"#ffffff","font":"display","align":"center","bold":true,"box":true,"glow":false,"start":18,"end":0}]},"hook":{"text":"What if x and y both follow a formula?"},"youtube":{"title":"Parametric curves: circle, ellipse, Lissajous ➰ #shorts","description":"Give x and y each their own formula of s and the pen draws a path. Cos and sin draw a circle, stretching one draws an ellipse, and different speeds draw a Lissajous figure.\n\n#math #learn #shorts","tags":"math, physics, learn, education, science, satisfying, shorts"}}]}
